<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.mapper.QuestionMapper">
    <resultMap id="getQuestionByIdMap" type="org.example.entity.Question">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="title" column="title" jdbcType="VARCHAR"/>
        <result property="type" column="type" jdbcType="VARCHAR"/>
        <result property="multi" column="multi" jdbcType="BIT"/>
        <result property="categoryId" column="category_id" jdbcType="BIGINT"/>
        <result property="difficulty" column="difficulty" jdbcType="VARCHAR"/>
        <result property="score" column="score" jdbcType="INTEGER"/>
        <result property="paperScore" column="paper_score" jdbcType="DECIMAL"/>
        <result property="analysis" column="analysis" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="isDeleted" column="is_deleted" jdbcType="BIT"/>
    </resultMap>

    <select id="selectCountByCategoryId" resultType="java.util.HashMap">
        select category_id as categoryId,count(1) as count
        from questions
        where is_deleted = 0
        group by category_id
    </select>
    <select id="getQuestionById" resultType="org.example.entity.Question">

    </select>


</mapper>
